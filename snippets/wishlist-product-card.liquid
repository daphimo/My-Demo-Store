{%- liquid
  assign card_image = product.featured_media.preview_image | default: product.featured_image
  assign current_variant = product.selected_or_first_available_variant
-%}
{%- if product.handle != blank -%}
<article class="wishlist-product-card" data-product-id="{{ product.id }}" data-product-handle="{{ product.handle | escape }}" data-variant-id="{{ current_variant.id }}" data-product-available="{{ current_variant.available }}">
  <div class="wishlist-product-card__media">
    <a href="{{ product.url }}" class="wishlist-product-card__image-link" aria-label="{{ product.title | escape }}" tabindex="-1">
      {%- if card_image != blank -%}
        {{ card_image | image_url: width: 900 | image_tag: widths: '240, 360, 480, 640, 750, 900', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw', loading: 'lazy', class: 'wishlist-product-card__image', alt: card_image.alt }}
      {%- else -%}
        {{ 'product-apparel-1' | placeholder_svg_tag: 'wishlist-product-card__image wishlist-product-card__placeholder' }}
      {%- endif -%}
    </a>
    {% render 'wishlist-button', product: product %}
  </div>
  <div class="wishlist-product-card__content">
    <h3 class="wishlist-product-card__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
    <div class="wishlist-product-card__price">
      {%- if product.price_varies -%}
        <span>From {{ product.price_min | money }}</span>
      {%- else -%}
        <span>{{ current_variant.price | money }}</span>
        {%- if current_variant.compare_at_price > current_variant.price -%}<s>{{ current_variant.compare_at_price | money }}</s>{%- endif -%}
      {%- endif -%}
      {%- unless product.available -%}<span class="wishlist-product-card__sold-out">{{ 'products.product.sold_out' | t }}</span>{%- endunless -%}
    </div>
  </div>
</article>
{%- endif -%}
