{{ 'contact-page.css' | asset_url | stylesheet_tag }}
{%- style -%}#shopify-section-{{ section.id }}{--contact-pt:{{ section.settings.padding_top }}px;--contact-pb:{{ section.settings.padding_bottom }}px;--contact-mpt:{{ section.settings.mobile_padding_top }}px;--contact-mpb:{{ section.settings.mobile_padding_bottom }}px}{%- endstyle -%}
<section class="contact-page contact-intro"><div class="contact-page__container">
  {%- if section.settings.eyebrow != blank -%}<p class="contact-intro__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
  <h1 class="contact-intro__heading">{{ section.settings.heading }}</h1>
  {%- if section.settings.description != blank -%}<div class="contact-intro__description rte">{{ section.settings.description }}</div>{%- endif -%}
</div></section>
{% schema %}{"name":"Contact intro","tag":"section","class":"section","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"CONTACT"},{"type":"inline_richtext","id":"heading","label":"Heading","default":"Say hi 💌"},{"type":"richtext","id":"description","label":"Description","default":"<p>Order help, gifting advice, bulk hampers or just to show us your desk setup — we read everything.</p>"},{"type":"range","id":"padding_top","label":"Desktop top padding","min":0,"max":160,"step":4,"unit":"px","default":48},{"type":"range","id":"padding_bottom","label":"Desktop bottom padding","min":0,"max":160,"step":4,"unit":"px","default":24},{"type":"range","id":"mobile_padding_top","label":"Mobile top padding","min":0,"max":100,"step":4,"unit":"px","default":32},{"type":"range","id":"mobile_padding_bottom","label":"Mobile bottom padding","min":0,"max":100,"step":4,"unit":"px","default":20}],"presets":[{"name":"Contact intro"}]}{% endschema %}
