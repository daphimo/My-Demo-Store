{{ 'section-richtext-custom.css' | asset_url | stylesheet_tag }}

<section
  class="custom-richtext"
  style="--section-page-width: {{ settings.page_width | divided_by: 10.0 }}rem; --richtext-background: {{ section.settings.background_color }}; --richtext-max-width: {{ section.settings.content_width }}px; --richtext-padding-top: {{ section.settings.padding_top }}px; --richtext-padding-bottom: {{ section.settings.padding_bottom }}px; --richtext-mobile-padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px; --richtext-mobile-padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;"
>
  <div class="custom-richtext__inner">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'title' -%}
          {%- if block.settings.title != blank -%}
            <{{ block.settings.heading_tag }}
              class="custom-richtext__title"
              style="--title-color: {{ block.settings.color }}; --title-size: {{ block.settings.size }}px;"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.title }}
            </{{ block.settings.heading_tag }}>
          {%- endif -%}

        {%- when 'content' -%}
          {%- if block.settings.content != blank -%}
            <div
              class="custom-richtext__content rte"
              style="--content-color: {{ block.settings.color }}; --content-size: {{ block.settings.size }}px;"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.content }}
            </div>
          {%- endif -%}

        {%- when 'buttons' -%}
          {%- if block.settings.button_1_text != blank or block.settings.button_2_text != blank -%}
            <div class="custom-richtext__buttons" {{ block.shopify_attributes }}>
              {%- if block.settings.button_1_text != blank -%}
                {% render 'button',
                  text: block.settings.button_1_text,
                  link: block.settings.button_1_link,
                  background: block.settings.button_1_background,
                  text_color: block.settings.button_1_text_color,
                  show_arrow: block.settings.button_1_arrow,
                  open_in_new_tab: block.settings.button_1_new_tab,
                  class: 'custom-richtext__button',
                  icon_class: 'custom-richtext__button-icon'
                %}
              {%- endif -%}

              {%- if block.settings.button_2_text != blank -%}
                {% render 'button',
                  text: block.settings.button_2_text,
                  link: block.settings.button_2_link,
                  background: block.settings.button_2_background,
                  text_color: block.settings.button_2_text_color,
                  show_arrow: block.settings.button_2_arrow,
                  open_in_new_tab: block.settings.button_2_new_tab,
                  class: 'custom-richtext__button',
                  icon_class: 'custom-richtext__button-icon'
                %}
              {%- endif -%}
            </div>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Custom rich text",
  "tag": "section",
  "class": "custom-richtext-section section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#FAD7E9" },
    { "type": "range", "id": "content_width", "label": "Content width", "min": 400, "max": 1200, "step": 20, "unit": "px", "default": 760 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 20, "max": 160, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 20, "max": 160, "step": 4, "unit": "px", "default": 36 }
  ],
  "blocks": [
    {
      "type": "title",
      "name": "Title",
      "settings": [
        { "type": "inline_richtext", "id": "title", "label": "Title", "default": "Why should everyday be boring?" },
        { "type": "select", "id": "heading_tag", "label": "Heading tag", "default": "h2", "options": [{ "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }, { "value": "h4", "label": "H4" }] },
        { "type": "range", "id": "size", "label": "Title size", "min": 20, "max": 80, "step": 1, "unit": "px", "default": 32 },
        { "type": "color", "id": "color", "label": "Title color", "default": "#2A0F1C" }
      ]
    },
    {
      "type": "content",
      "name": "Content",
      "settings": [
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Your coffee deserves a cute companion.<br>Your desk deserves some personality.<br>Your bag deserves a little charm.<br>And you deserve some joy. 💕</p>" },
        { "type": "range", "id": "size", "label": "Content size", "min": 12, "max": 32, "step": 1, "unit": "px", "default": 16 },
        { "type": "color", "id": "color", "label": "Content color", "default": "#3D1729" }
      ]
    },
    {
      "type": "buttons",
      "name": "Buttons",
      "settings": [
        { "type": "text", "id": "button_1_text", "label": "Button 1 text", "default": "Enter the CocoPoco world" },
        { "type": "url", "id": "button_1_link", "label": "Button 1 link" },
        { "type": "color", "id": "button_1_background", "label": "Button 1 background", "default": "#3D1729" },
        { "type": "color", "id": "button_1_text_color", "label": "Button 1 text color", "default": "#FFFFFF" },
        { "type": "checkbox", "id": "button_1_arrow", "label": "Show arrow on button 1", "default": true },
        { "type": "checkbox", "id": "button_1_new_tab", "label": "Open button 1 in a new tab", "default": false },
        { "type": "text", "id": "button_2_text", "label": "Button 2 text" },
        { "type": "url", "id": "button_2_link", "label": "Button 2 link" },
        { "type": "color", "id": "button_2_background", "label": "Button 2 background", "default": "#FFFFFF" },
        { "type": "color", "id": "button_2_text_color", "label": "Button 2 text color", "default": "#3D1729" },
        { "type": "checkbox", "id": "button_2_arrow", "label": "Show arrow on button 2", "default": false },
        { "type": "checkbox", "id": "button_2_new_tab", "label": "Open button 2 in a new tab", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom rich text",
      "blocks": [
        { "type": "title" },
        { "type": "content" },
        { "type": "buttons" }
      ]
    }
  ]
}
{% endschema %}
