{{ 'about-us.css' | asset_url | stylesheet_tag }}

<section class="about-us about-us-hero" style="--about-pt: {{ section.settings.padding_top }}px; --about-pb: {{ section.settings.padding_bottom }}px; --about-mpt: {{ section.settings.mobile_padding_top }}px; --about-mpb: {{ section.settings.mobile_padding_bottom }}px; --hero-min: {{ section.settings.desktop_height }}px; --hero-mobile-min: {{ section.settings.mobile_height }}px;">
  <div class="about-us__container about-us-hero__container">
    {% if section.settings.eyebrow != blank %}<p class="about-us__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h1 class="about-us-hero__heading">{{ section.settings.heading }}</h1>
    {% if section.settings.description != blank %}<div class="about-us-hero__description">{{ section.settings.description }}</div>{% endif %}
  </div>
</section>

{% schema %}
{
  "name": "About hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "ABOUT US" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Romanticize Your Everyday" },
    { "type": "inline_richtext", "id": "description", "label": "Description", "default": "Cute everyday essentials — why be boring when you can be cute?" },
    { "type": "range", "id": "desktop_height", "label": "Desktop minimum height", "min": 220, "max": 400, "step": 10, "unit": "px", "default": 280 },
    { "type": "range", "id": "mobile_height", "label": "Mobile minimum height", "min": 180, "max": 300, "step": 10, "unit": "px", "default": 220 },
    { "type": "range", "id": "padding_top", "label": "Desktop top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Desktop bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "mobile_padding_top", "label": "Mobile top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Mobile bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 28 }
  ],
  "presets": [{ "name": "About hero" }]
}
{% endschema %}
