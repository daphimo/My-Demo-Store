{%- liquid
  assign wishlist_login_required = false
  if settings.wishlist_flow == 'login_required' and customer == blank
    assign wishlist_login_required = true
  endif
-%}
<section class="wishlist-page page-width"{% unless wishlist_login_required %} data-wishlist-section{% endunless %} style="--wishlist-padding-top: {{ section.settings.padding_top }}px; --wishlist-padding-bottom: {{ section.settings.padding_bottom }}px; --wishlist-banner-height: {{ section.settings.banner_height }}px; --wishlist-banner-height-mobile: {{ section.settings.mobile_banner_height }}px;">
  {%- if section.settings.image != blank or section.settings.mobile_image != blank -%}
    <div class="wishlist-page__banner">
      <picture>
        {%- if section.settings.mobile_image != blank -%}<source media="(max-width: 749px)" srcset="{{ section.settings.mobile_image | image_url: width: 1100 }}">{%- endif -%}
        {%- assign banner_image = section.settings.image | default: section.settings.mobile_image -%}
        {{ banner_image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: 'eager', class: 'wishlist-page__banner-image', alt: banner_image.alt }}
      </picture>
    </div>
  {%- endif -%}
  <header class="wishlist-page__header">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="wishlist-page__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h1 class="wishlist-page__title">{{ section.settings.title }}</h1>
      {%- if section.settings.description != blank -%}<div class="wishlist-page__description rte">{{ section.settings.description }}</div>{%- endif -%}
    </div>
    {%- unless wishlist_login_required -%}
      <button type="button" class="wishlist-page__add-all button" data-wishlist-add-all hidden aria-busy="false">{{ section.settings.add_all_label | escape }}</button>
    {%- endunless -%}
  </header>
  {%- if wishlist_login_required -%}
    <div class="wishlist-page__empty wishlist-page__login-required">
      <span class="wishlist-page__empty-icon">{% render 'wishlist-icon' %}</span>
      <h2>Please sign in to use your wishlist.</h2>
      <a class="button" href="{{ routes.account_login_url }}" target="_blank" rel="noopener">Sign In</a>
    </div>
  {%- else -%}
  {%- if settings.wishlist_flow == 'guest_signin' and customer == blank -%}
    <p class="wishlist-page__signin-message"><a href="{{ routes.account_login_url }}">Sign in</a> to save your wishlist items</p>
  {%- endif -%}
  <div class="wishlist-page__grid" grid-wishlist aria-live="polite" aria-busy="true">
    <div class="wishlist-page__loader" role="status"><span class="visually-hidden">Loading wishlist</span></div>
  </div>
  <div class="wishlist-page__empty" data-wishlist-empty hidden>
    <span class="wishlist-page__empty-icon">{% render 'wishlist-icon' %}</span>
    <h2>{{ section.settings.empty_title | escape }}</h2>
    <p>{{ section.settings.empty_text | escape }}</p>
    <a class="button" href="{{ routes.all_products_collection_url }}">{{ section.settings.continue_label | escape }}</a>
  </div>
  <p class="wishlist-page__status visually-hidden" data-wishlist-status role="status" aria-live="polite"></p>
  {%- endif -%}
</section>
{% schema %}
{
  "name": "Wishlist products",
  "settings": [
    {"type":"image_picker","id":"image","label":"Desktop cover image"},
    {"type":"image_picker","id":"mobile_image","label":"Mobile cover image"},
    {"type":"range","id":"banner_height","min":180,"max":600,"step":20,"unit":"px","label":"Desktop cover height","default":360},
    {"type":"range","id":"mobile_banner_height","min":140,"max":420,"step":20,"unit":"px","label":"Mobile cover height","default":240},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Saved for you"},
    {"type":"inline_richtext","id":"title","label":"Title","default":"Your Wishlist"},
    {"type":"richtext","id":"description","label":"Description","default":"<p>The pieces you love, all in one place.</p>"},
    {"type":"text","id":"add_all_label","label":"Add all button label","default":"Add all to cart"},
    {"type":"text","id":"empty_title","label":"Empty wishlist heading","default":"Your wishlist is waiting"},
    {"type":"textarea","id":"empty_text","label":"Empty wishlist text","default":"Save the pieces you love and find them here whenever you return."},
    {"type":"text","id":"continue_label","label":"Continue shopping label","default":"Explore the collection"},
    {"type":"range","id":"padding_top","min":20,"max":120,"step":4,"unit":"px","label":"Top padding","default":64},
    {"type":"range","id":"padding_bottom","min":20,"max":120,"step":4,"unit":"px","label":"Bottom padding","default":80}
  ],
  "presets": [{"name":"Wishlist products"}]
}
{% endschema %}
