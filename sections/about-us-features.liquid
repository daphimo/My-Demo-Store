{{ 'about-us.css' | asset_url | stylesheet_tag }}
<section class="about-us about-us-features" style="--about-pt: {{ section.settings.padding_top }}px; --about-pb: {{ section.settings.padding_bottom }}px; --about-mpt: {{ section.settings.mobile_padding_top }}px; --about-mpb: {{ section.settings.mobile_padding_bottom }}px;">
  <div class="about-us__container">
    <h2 class="about-us__heading about-us-features__heading">{{ section.settings.heading }}</h2>
    <div class="about-us-features__grid">
      {% for block in section.blocks %}<article class="about-us-feature" {{ block.shopify_attributes }}><h3>{{ block.settings.heading | escape }}</h3><p>{{ block.settings.description | escape }}</p></article>{% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "About features",
  "max_blocks": 3,
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Why CocoPoco" },
    { "type": "range", "id": "padding_top", "label": "Desktop top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Desktop bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "mobile_padding_top", "label": "Mobile top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Mobile bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 28 }
  ],
  "blocks": [{ "type": "feature", "name": "Feature", "settings": [{"type":"text","id":"heading","label":"Heading","default":"Feature"},{"type":"textarea","id":"description","label":"Description","default":"Describe this feature."}] }],
  "presets": [{ "name": "About features", "blocks": [{"type":"feature","settings":{"heading":"Curated by founders","description":"Every piece picked for quality, cuteness and daily use."}},{"type":"feature","settings":{"heading":"Affordable","description":"Gifts from ₹299, flat ₹99 shipping, partial COD."}},{"type":"feature","settings":{"heading":"Trend-first","description":"Stitch, Sanrio, Labubu and more — before local shops."}}] }]
}
{% endschema %}
