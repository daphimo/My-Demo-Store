{{ 'our-story.css' | asset_url | stylesheet_tag }}
{%- style -%}#shopify-section-{{ section.id }}{--story-pt:{{ section.settings.padding_top }}px;--story-pb:{{ section.settings.padding_bottom }}px;--story-mpt:{{ section.settings.mobile_padding_top }}px;--story-mpb:{{ section.settings.mobile_padding_bottom }}px}{%- endstyle -%}
<section class="our-story-founders"><div class="our-story-founders__container"><div class="our-story-founders__grid">
  {%- for block in section.blocks -%}<article class="our-story-founder" {{ block.shopify_attributes }}>
    <div class="our-story-founder__media">{%- if block.settings.image != blank -%}{%- assign founder_image_style = 'object-position: ' | append: block.settings.image_position -%}{{ block.settings.image | image_url: width: 1000 | image_tag: class: 'our-story-founder__image', widths: '320, 480, 640, 800, 1000', sizes: '(min-width: 750px) 30rem, calc(100vw - 32px)', loading: 'lazy', alt: block.settings.name, style: founder_image_style }}{%- else -%}{{ 'image' | placeholder_svg_tag: 'our-story-founder__image placeholder-svg' }}{%- endif -%}</div>
    <div class="our-story-founder__meta">{%- if block.settings.eyebrow != blank -%}<p class="our-story-founder__eyebrow">{{ block.settings.eyebrow | escape }}</p>{%- endif -%}{%- if block.settings.name != blank -%}<h2 class="our-story-founder__name">{{ block.settings.name | escape }}</h2>{%- endif -%}{%- if block.settings.role != blank -%}<p class="our-story-founder__role">{{ block.settings.role | escape }}</p>{%- endif -%}</div>
  </article>{%- endfor -%}
</div></div></section>
{% schema %}
{"name":"Our story founders","tag":"section","class":"section","settings":[{"type":"range","id":"padding_top","label":"Desktop top padding","min":0,"max":160,"step":4,"unit":"px","default":40},{"type":"range","id":"padding_bottom","label":"Desktop bottom padding","min":0,"max":160,"step":4,"unit":"px","default":40},{"type":"range","id":"mobile_padding_top","label":"Mobile top padding","min":0,"max":100,"step":4,"unit":"px","default":28},{"type":"range","id":"mobile_padding_bottom","label":"Mobile bottom padding","min":0,"max":100,"step":4,"unit":"px","default":28}],"blocks":[{"type":"founder","name":"Founder","limit":2,"settings":[{"type":"image_picker","id":"image","label":"Founder image"},{"type":"select","id":"image_position","label":"Image position","default":"center center","options":[{"value":"center center","label":"Center"},{"value":"center top","label":"Top"},{"value":"center bottom","label":"Bottom"},{"value":"left center","label":"Left"},{"value":"right center","label":"Right"}]},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"everyday romantic"},{"type":"text","id":"name","label":"Name"},{"type":"text","id":"role","label":"Role","default":"Co-Founder"}]}],"presets":[{"name":"Our story founders","blocks":[{"type":"founder","settings":{"name":"Sweta Kindo"}},{"type":"founder","settings":{"name":"Smita Bara"}}]}]}
{% endschema %}
