{{ 'our-story.css' | asset_url | stylesheet_tag }}
{%- style -%}#shopify-section-{{ section.id }}{--story-pt:{{ section.settings.padding_top }}px;--story-pb:{{ section.settings.padding_bottom }}px;--story-mpt:{{ section.settings.mobile_padding_top }}px;--story-mpb:{{ section.settings.mobile_padding_bottom }}px}{%- endstyle -%}
<section class="our-story-content"><div class="our-story-content__container"><div class="our-story-content__body rte">{{ section.settings.content }}</div></div></section>
{% schema %}
{"name":"Our story content","tag":"section","class":"section","settings":[{"type":"richtext","id":"content","label":"Story content","default":"<p>As children, we believed that the smallest things could make an ordinary day feel special — a new notebook, a cute pen, a sticker sheet we never wanted to use because it was simply too pretty.</p><p>Years later, as <strong>mothers ourselves</strong>, we wanted our children to feel that same little joy in everyday moments.</p><h3>So, in 2024, we decided to create one.</h3><p>Founded by sisters <strong>Smita Bara</strong> and <strong>Sweta Kindo</strong>, CocoPoco started with one simple mission: to help you romanticize your everyday.</p><p>Today, CocoPoco brings together kawaii stationery, aesthetic gifts, and cute everyday essentials.</p><p>Because life doesn’t need a special occasion to feel special.</p><h3>So why not “Romanticize your Everyday”</h3>"},{"type":"range","id":"padding_top","label":"Desktop top padding","min":0,"max":160,"step":4,"unit":"px","default":0},{"type":"range","id":"padding_bottom","label":"Desktop bottom padding","min":0,"max":160,"step":4,"unit":"px","default":80},{"type":"range","id":"mobile_padding_top","label":"Mobile top padding","min":0,"max":100,"step":4,"unit":"px","default":0},{"type":"range","id":"mobile_padding_bottom","label":"Mobile bottom padding","min":0,"max":100,"step":4,"unit":"px","default":48}],"presets":[{"name":"Our story content"}]}
{% endschema %}
