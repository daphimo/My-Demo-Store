{{ 'contact-page.css' | asset_url | stylesheet_tag }}
{%- style -%}#shopify-section-{{ section.id }}{--contact-pt:{{ section.settings.padding_top }}px;--contact-pb:{{ section.settings.padding_bottom }}px;--contact-mpt:{{ section.settings.mobile_padding_top }}px;--contact-mpb:{{ section.settings.mobile_padding_bottom }}px}{%- endstyle -%}
<section class="contact-page contact-get-in-touch"><div class="contact-page__container"><h2 class="contact-get-in-touch__heading">{{ section.settings.heading }}</h2>{%- if section.settings.description != blank -%}<div class="contact-get-in-touch__description rte">{{ section.settings.description }}</div>{%- endif -%}</div></section>
{% schema %}{"name":"Contact heading","tag":"section","class":"section","settings":[{"type":"inline_richtext","id":"heading","label":"Heading","default":"Get in Touch"},{"type":"richtext","id":"description","label":"Description","default":"<p>We'd love to hear from you. Call, message, or drop by our shop.</p>"},{"type":"range","id":"padding_top","label":"Desktop top padding","min":0,"max":160,"step":4,"unit":"px","default":24},{"type":"range","id":"padding_bottom","label":"Desktop bottom padding","min":0,"max":160,"step":4,"unit":"px","default":20},{"type":"range","id":"mobile_padding_top","label":"Mobile top padding","min":0,"max":100,"step":4,"unit":"px","default":20},{"type":"range","id":"mobile_padding_bottom","label":"Mobile bottom padding","min":0,"max":100,"step":4,"unit":"px","default":16}],"presets":[{"name":"Contact heading"}]}{% endschema %}
