{{ 'contact-page.css' | asset_url | stylesheet_tag }}
{%- style -%}#shopify-section-{{ section.id }}{--contact-pt:{{ section.settings.padding_top }}px;--contact-pb:{{ section.settings.padding_bottom }}px;--contact-mpt:{{ section.settings.mobile_padding_top }}px;--contact-mpb:{{ section.settings.mobile_padding_bottom }}px}{%- endstyle -%}
<section class="contact-page contact-methods"><div class="contact-page__container"><div class="contact-methods__grid">
{%- for block in section.blocks -%}{%- capture card_content -%}<span class="contact-method__icon">{% render 'contact-icon', icon: block.settings.icon %}</span><h3 class="contact-method__heading">{{ block.settings.heading }}</h3><div class="contact-method__text rte">{{ block.settings.content }}</div>{%- endcapture -%}
{%- if block.settings.link != blank -%}<a class="contact-method contact-method--link" href="{{ block.settings.link }}"{% if block.settings.open_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %} {{ block.shopify_attributes }}>{{ card_content }}</a>{%- else -%}<div class="contact-method" {{ block.shopify_attributes }}>{{ card_content }}</div>{%- endif -%}{%- endfor -%}
</div></div></section>
{% schema %}{"name":"Contact methods","tag":"section","class":"section","settings":[{"type":"range","id":"padding_top","label":"Desktop top padding","min":0,"max":160,"step":4,"unit":"px","default":0},{"type":"range","id":"padding_bottom","label":"Desktop bottom padding","min":0,"max":160,"step":4,"unit":"px","default":48},{"type":"range","id":"mobile_padding_top","label":"Mobile top padding","min":0,"max":100,"step":4,"unit":"px","default":0},{"type":"range","id":"mobile_padding_bottom","label":"Mobile bottom padding","min":0,"max":100,"step":4,"unit":"px","default":32}],"blocks":[{"type":"contact_method","name":"Contact method","limit":4,"settings":[{"type":"select","id":"icon","label":"Icon","default":"phone","options":[{"value":"phone","label":"Phone"},{"value":"mail","label":"Email"},{"value":"location","label":"Location"},{"value":"clock","label":"Clock"},{"value":"instagram","label":"Instagram"},{"value":"sparkles","label":"Sparkles"},{"value":"star","label":"Star"}]},{"type":"inline_richtext","id":"heading","label":"Heading","default":"Contact method"},{"type":"richtext","id":"content","label":"Content","default":"<p>Add contact details</p>"},{"type":"url","id":"link","label":"Optional link"},{"type":"checkbox","id":"open_new_tab","label":"Open link in new tab","default":false}]}],"presets":[{"name":"Contact methods","blocks":[{"type":"contact_method","settings":{"icon":"phone","heading":"Call Us","content":"<p>+91 85840 72905</p>"}},{"type":"contact_method","settings":{"icon":"phone","heading":"WhatsApp","content":"<p>+91 85840 72905</p>"}},{"type":"contact_method","settings":{"icon":"mail","heading":"Email","content":"<p>info@cocopoco.in</p>"}},{"type":"contact_method","settings":{"icon":"location","heading":"Visit Us","content":"<p>Ground floor, Plot No A1-97, New Town, Kolkata – 700156</p>"}}]}]}{% endschema %}
