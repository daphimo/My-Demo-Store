{{ 'contact-page.css' | asset_url | stylesheet_tag }}
{%- style -%}#shopify-section-{{ section.id }}{--contact-pt:{{ section.settings.padding_top }}px;--contact-pb:{{ section.settings.padding_bottom }}px;--contact-mpt:{{ section.settings.mobile_padding_top }}px;--contact-mpb:{{ section.settings.mobile_padding_bottom }}px}{%- endstyle -%}
<section class="contact-page contact-form-section"><div class="contact-page__container"><div class="contact-form-layout">
<div class="contact-form-card">{% if section.settings.heading != blank %}<h2 class="contact-form-card__heading">{{ section.settings.heading }}</h2>{% endif %}
{% assign form_id = 'ContactForm-' | append: section.id %}{% form 'contact', id: form_id, class: 'contact-form' %}
{% if form.posted_successfully? %}<div class="contact-form__status contact-form__status--success" role="status" tabindex="-1" autofocus>{{ 'templates.contact.form.post_success' | t }}</div>{% elsif form.errors %}<div class="contact-form__status contact-form__status--error" role="alert" tabindex="-1" autofocus>{{ 'templates.contact.form.error_heading' | t }} {{ form.errors | default_errors }}</div>{% endif %}
<div class="contact-form__grid">
<div class="contact-form__field"><label for="ContactForm-name-{{ section.id }}">Your name</label><input id="ContactForm-name-{{ section.id }}" type="text" name="contact[name]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" autocomplete="name" required></div>
<div class="contact-form__field"><label for="ContactForm-email-{{ section.id }}">Email</label><input id="ContactForm-email-{{ section.id }}" type="email" name="contact[email]" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" autocomplete="email" autocapitalize="off" spellcheck="false" required{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}></div>
<div class="contact-form__field"><label for="ContactForm-order-{{ section.id }}">Order number <span>(optional)</span></label><input id="ContactForm-order-{{ section.id }}" type="text" name="contact[Order number]"></div>
<div class="contact-form__field"><label for="ContactForm-subject-{{ section.id }}">What's this about?</label><select id="ContactForm-subject-{{ section.id }}" name="contact[Subject]">{% assign subject_options = section.settings.subject_options | split: ',' %}{% for option in subject_options %}{% assign clean_option = option | strip %}{% if clean_option != blank %}<option value="{{ clean_option | escape }}">{{ clean_option | escape }}</option>{% endif %}{% endfor %}</select></div>
<div class="contact-form__field contact-form__field--full"><label for="ContactForm-body-{{ section.id }}">Your message</label><textarea id="ContactForm-body-{{ section.id }}" name="contact[body]" rows="7" placeholder="{{ section.settings.message_placeholder | escape }}" required>{{ form.body }}</textarea></div>
</div><button class="contact-form__submit" type="submit">{{ section.settings.button_text | escape }}</button>{% if section.settings.response_text != blank %}<p class="contact-form__response">{{ section.settings.response_text | escape }}</p>{% endif %}{% endform %}</div>
<aside class="contact-quick-links" aria-label="Quick contact information">{% for block in section.blocks %}{% capture quick_content %}<span class="contact-quick-link__icon">{% render 'contact-icon', icon: block.settings.icon %}</span><span class="contact-quick-link__content"><strong>{{ block.settings.heading }}</strong><span>{{ block.settings.content }}</span></span>{% endcapture %}{% if block.settings.link != blank %}<a class="contact-quick-link contact-quick-link--linked" href="{{ block.settings.link }}"{% if block.settings.open_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %} {{ block.shopify_attributes }}>{{ quick_content }}</a>{% else %}<div class="contact-quick-link" {{ block.shopify_attributes }}>{{ quick_content }}</div>{% endif %}{% endfor %}</aside>
</div></div></section>
{% schema %}
{"name":"Contact form & links","tag":"section","class":"section","settings":[{"type":"inline_richtext","id":"heading","label":"Form heading","default":"Send us a message"},{"type":"textarea","id":"subject_options","label":"Subject options","info":"Separate options with commas.","default":"My order, Product question, Bulk order, Gift help, Other"},{"type":"text","id":"message_placeholder","label":"Message placeholder","default":"Tell us everything..."},{"type":"text","id":"button_text","label":"Button text","default":"Send message"},{"type":"text","id":"response_text","label":"Response time text","default":"We usually reply within a few hours, Mon–Sat."},{"type":"range","id":"padding_top","label":"Desktop top padding","min":0,"max":160,"step":4,"unit":"px","default":24},{"type":"range","id":"padding_bottom","label":"Desktop bottom padding","min":0,"max":160,"step":4,"unit":"px","default":64},{"type":"range","id":"mobile_padding_top","label":"Mobile top padding","min":0,"max":100,"step":4,"unit":"px","default":20},{"type":"range","id":"mobile_padding_bottom","label":"Mobile bottom padding","min":0,"max":100,"step":4,"unit":"px","default":48}],"blocks":[{"type":"quick_contact","name":"Quick contact","limit":4,"settings":[{"type":"select","id":"icon","label":"Icon","default":"instagram","options":[{"value":"phone","label":"Phone"},{"value":"mail","label":"Email"},{"value":"location","label":"Location"},{"value":"clock","label":"Clock"},{"value":"instagram","label":"Instagram"},{"value":"sparkles","label":"Sparkles"},{"value":"star","label":"Star"}]},{"type":"inline_richtext","id":"heading","label":"Heading","default":"Quick contact"},{"type":"inline_richtext","id":"content","label":"Content","default":"Add details"},{"type":"url","id":"link","label":"Optional link"},{"type":"checkbox","id":"open_new_tab","label":"Open link in new tab","default":false}]}],"presets":[{"name":"Contact form & links","blocks":[{"type":"quick_contact","settings":{"icon":"instagram","heading":"Instagram DMs","content":"@cocopocothegiftshop"}},{"type":"quick_contact","settings":{"icon":"phone","heading":"WhatsApp","content":"+91 85840 72905"}},{"type":"quick_contact","settings":{"icon":"mail","heading":"Email","content":"info@cocopoco.in"}},{"type":"quick_contact","settings":{"icon":"clock","heading":"Support hours","content":"Mon–Sat, 10am–6pm"}}]}]}
{% endschema %}
